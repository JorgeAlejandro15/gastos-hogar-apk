{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://gastos-backend-qppv.onrender.com/api",
        "EXPO_PUBLIC_API_TIMEOUT_MS": "15000"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
