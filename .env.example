# Copy to .env and adjust for your environment
# IMPORTANT: On a physical phone, do NOT use localhost/127.0.0.1.
# Use your laptop IP (the one shown in the Expo QR: exp://<IP>:8081).
# Backend uses a global prefix 'api', so keep the /api suffix.
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api
EXPO_PUBLIC_API_TIMEOUT_MS=15000
